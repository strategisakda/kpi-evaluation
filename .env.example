# ==== Supabase (จำเป็น) ====
# เอาจาก Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key = ใช้ฝั่ง server เท่านั้น ห้ามส่งไป client และห้าม commit
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ==== Anthropic Claude (optional — ไม่มีก็ปิด AI อัตโนมัติ) ====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ==== อื่น ๆ (optional) ====
# ชื่อ bucket สำหรับเก็บไฟล์หลักฐานใน Supabase Storage
EVIDENCE_BUCKET=evidence

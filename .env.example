# ==== Supabase (จำเป็น) ====
# เอาจาก Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key = ใช้ฝั่ง server เท่านั้น ห้ามส่งไป client และห้าม commit
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ==== Anthropic Claude (optional — ไม่มีก็ปิด AI อัตโนมัติ) ====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ==== อื่น ๆ (optional) ====
# ชื่อ bucket สำหรับเก็บไฟล์หลักฐานใน Supabase Storage
EVIDENCE_BUCKET=evidence

# ==== SMTP แจ้งเตือนอีเมล (optional — ไม่ตั้งค่าก็ข้ามการส่งอีเมลอัตโนมัติ) ====
# ตัวอย่าง Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=App Password (ต้องเปิด 2-Step Verification แล้วสร้าง App Password ที่
# https://myaccount.google.com/apppasswords ห้ามใช้รหัสผ่าน Gmail ปกติ)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
